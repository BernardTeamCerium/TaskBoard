# Copy to .env (or set these in your hosting provider's dashboard).

PORT=3000
# Public URL people use to reach the board (used in email links; https enables secure cookies)
APP_URL=https://tasks.example.com
# Deadlines without a time are 5pm in this timezone
TZ=America/New_York
DB_PATH=data/taskboard.db
# Set to 1 when running behind a reverse proxy / load balancer
TRUST_PROXY=0

# --- Email notifications (optional) ---
# Any SMTP provider, e.g. smtps://USER:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM="TaskBoard <tasks@example.com>"
# The address that forwards into /api/inbound/email. Used as Reply-To so replying to a notification adds a comment.
INBOUND_EMAIL_ADDRESS=tasks@inbound.example.com
# Hour (0-23) for the morning digest email; also adjustable in Settings
DIGEST_HOUR=8

# --- Chat / phone push for reminders (optional) ---
# Slack/Discord/Teams incoming webhook, or an ntfy.sh topic URL for free phone push notifications
NOTIFY_WEBHOOK_URL=

# --- AI message interpretation with Claude (optional) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
